# LiveWire server configuration. Copy to /opt/livewire/.env (install.sh does this)
# and fill in the values marked REPLACE_ME. Never commit the real file.

# --- City ------------------------------------------------------------------
CITY=lincoln

# --- Audio source (user-supplied; Broadcastify Premium raw stream URL) -----
STREAM_URL=REPLACE_ME_STREAM_URL
# Optional extra HTTP headers for ffmpeg, e.g. "Cookie: ...\r\n"
STREAM_HEADERS=

# --- Transcription: local | groq | openai ---------------------------------
TRANSCRIBER=groq
GROQ_API_KEY=REPLACE_ME_GROQ_API_KEY
# or, with TRANSCRIBER=openai:
OPENAI_API_KEY=
# local faster-whisper only (needs requirements-local-whisper.txt):
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Extraction (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
EXTRACT_MODEL=claude-haiku-4-5-20251001

# --- Geocoding: nominatim | mapbox -----------------------------------------
GEOCODER=nominatim
MAPBOX_TOKEN=

# --- Voice activity (energy gate, used when torch is not installed) --------
ENERGY_GATE_THRESHOLD=0.015
ENERGY_HANGOVER_MS=300

# --- Police feed delay fallback (seconds) until a clock read is heard -----
DEFAULT_POLICE_DELAY_SEC=900

# --- API ---------------------------------------------------------------------
# Shared secret; the app sends it as "Authorization: Bearer <API_TOKEN>".
# install.sh generates a random one. Put the same value in the app's Settings.
API_TOKEN=REPLACE_ME_API_TOKEN
HOST=127.0.0.1
PORT=8000

# --- Push notifications (APNs token auth) ----------------------------------
APNS_KEY_PATH=/opt/livewire/apns.p8
APNS_KEY_ID=REPLACE_ME_APNS_KEY_ID
APNS_TEAM_ID=REPLACE_ME_TEAM_ID
APNS_BUNDLE_ID=com.REPLACE_ME_BUNDLE_PREFIX.livewire
# true for Xcode/dev builds (sandbox APNs), false for TestFlight/App Store
APNS_SANDBOX=true
